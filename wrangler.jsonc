{
  // Cloudflare Workers + Static Assets for lev-hatahbiv.
  //   - serves the built SPA (Frontend/dist) via the ASSETS binding
  //   - runs the dynamic API (worker/index.ts) for /api/* — coupons now, payments later
  // Last activation step (do it yourself, they're secrets):
  //   npx wrangler secret put ADMIN_JWT_SECRET   (= the backend's JWT SECRET)
  //   npx wrangler secret put PAYME_SELLER_ID    (the "MPL..." key from PayMe; sandbox first)
  //   npx wrangler secret put PAYME_WEBHOOK_KEY  (any long random string — auths the callbacks)
  // then:  npx wrangler deploy
  "name": "lev-hatahbiv",
  "compatibility_date": "2026-06-18",
  "main": "worker/index.ts",
  "vars": {
    // PayMe API base. LIVE — real money. Sandbox was https://sandbox.payme.io/api;
    // switching back also requires putting the sandbox MPL back in PAYME_SELLER_ID
    // (the two environments are separate accounts with separate keys).
    "PAYME_BASE_URL": "https://live.payme.io/api",
    // SEO: every other host (apex, workers.dev) 301s to it. Set on cutover day
    // (Aug 29 2026) — the nameservers point at Cloudflare and both the apex and
    // www are Worker custom domains.
    // ⚠️ TEMPORARILY EMPTY (2026-08-30): www.lev-hatahbiv.com intermittently
    // returns Cloudflare Error 1034 (edge hostname-binding stuck on some POPs —
    // ticket open with Cloudflare). An empty value disables the apex→www bounce
    // so the healthy apex serves everyone. RESTORE to "www.lev-hatahbiv.com"
    // once www is confirmed stable again.
    "CANONICAL_HOST": ""
  },
  // safety net: re-query PayMe for orders that were paid but never settled
  // (shopper closed the tab AND the callback didn't arrive). See scheduled().
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "assets": {
    "directory": "./Frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The Worker runs for EVERY request and serves files itself via env.ASSETS (worker/seo.ts).
    // Needed because "/" is a real asset (index.html): with asset-first routing the Worker
    // would never see the home page, which is exactly where the CANONICAL_HOST redirect
    // (apex → www) matters most. An array form (["/"]) is NOT an option — it bypasses the
    // Worker for every non-listed path, killing /api/* and the legacy redirects.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lev",
      "database_id": "b319d68e-ce60-4e79-9395-46744b015160",
      "remote": true
    }
  ]
}
